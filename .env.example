# ECRXN Dispatch settings. Copy to .env and edit; restart after changes.
# The installers create .env for you.

# --------------- Logging ---------------
# 1=DEBUG 2=INFO 3=WARNING 4=ERROR 5=CRITICAL
LOG_LEVEL=2

# --------------- Timezone (IANA name) ---------------
TIMEZONE=America/New_York

# --------------- Web server ---------------
# Address people use to reach this server (used in alert links). Include http:// or https://
BASE_URL=http://192.168.1.50:9911
HOST=0.0.0.0
PORT=9911
WEB_CONCURRENCY=1
WEB_THREADS=8
WEB_TIMEOUT=60

# --------------- Cookies ---------------
# SECURE=True when using HTTPS. DOMAIN should match the host in BASE_URL.
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_DOMAIN=192.168.1.50
SESSION_COOKIE_NAME=icad_dispatch
SESSION_COOKIE_PATH=/

# --------------- Database ---------------
SQLITE_DATABASE_PATH=var/icad_dispatch.db

# --------------- Admin account (created on first start only) ---------------
ROOT_USERNAME=admin
ROOT_PASSWORD=changeme123

# Forgot the password? Uncomment, set a new one and restart. It's applied once and this line is removed.
# RESET_ADMIN_PASSWORD=

# --------------- Optional limits ---------------
# Wrong passwords before a 15-minute lockout (per address; an account allows 4x as many)
# LOGIN_MAX_ATTEMPTS=8
# LOGIN_LOCKOUT_MINUTES=15
# Largest upload the web server accepts, in MB (Facebook background clips can be up to 2 GB)
# MAX_UPLOAD_MB=2100
# Facebook video backgrounds: largest picture / clip upload, in MB
# FACEBOOK_MAX_IMAGE_MB=250
# FACEBOOK_MAX_CLIP_MB=2048
# FACEBOOK_GRAPH_VERSION=v26.0

# --------------- AI features ---------------
# Shared OpenAI key, used when a system's own AI settings have none
# OPENAI_API_KEY=
